{
  "name": "rtail",
  "version": "2.0.0-dev",
  "description": "Terminal output to the browser in seconds, using UNIX pipes.",
  "keywords": [
    "log",
    "logging",
    "logio",
    "logs",
    "tail",
    "udp"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "//": "v2 ships the server as a Go binary with the webapp embedded; npm now carries only the client pipe. See docs/proposal-logging-system.md.",
  "bin": {
    "rtail": "./cli/rtail-client.js"
  },
  "files": [
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:kilianc/rtail.git"
  },
  "dependencies": {
    "chrono-node": "^2.7.7",
    "json5": "^2.2.3",
    "strip-ansi": "^7.1.0",
    "update-notifier": "^7.3.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "ansi_up": "^6.0.2",
    "esbuild": "^0.24.2",
    "highlight.js": "^11.11.1",
    "preact": "^10.25.4",
    "sass": "^1.83.0",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "dev": "node tools/dev.js",
    "build": "node tools/build.js",
    "dist": "node tools/build.js --dist",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.js"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "not op_mini all"
  ],
  "author": "Kilian Ciuffolo <me@nailik.org>",
  "license": "AGPL-3.0-only"
}
