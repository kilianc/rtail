{
  "name": "rtail",
  "version": "0.2.1",
  "description": "Terminal output to the browser in seconds, using UNIX pipes.",
  "keywords": [
    "log",
    "logging",
    "logio",
    "logs",
    "tail",
    "udp"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "rtail": "./cli/rtail-client.js",
    "rtail-server": "./cli/rtail-server.js"
  },
  "files": [
    "cli",
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:kilianc/rtail.git"
  },
  "dependencies": {
    "chrono-node": "^2.7.7",
    "debug": "^4.4.0",
    "express": "^4.21.2",
    "json5": "^2.2.3",
    "socket.io": "^4.8.1",
    "strip-ansi": "^7.1.0",
    "update-notifier": "^7.3.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "ansi_up": "^6.0.2",
    "esbuild": "^0.24.2",
    "highlight.js": "^11.11.1",
    "preact": "^10.25.4",
    "sass": "^1.83.0",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "dev": "node tools/dev.js",
    "build": "node tools/build.js",
    "dist": "node tools/build.js --dist",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.js",
    "prepack": "node tools/build.js --dist"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "not op_mini all"
  ],
  "author": "Kilian Ciuffolo <me@nailik.org>",
  "license": "MIT"
}
