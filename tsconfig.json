{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,

    // Nothing is compiled: the CLI ships as TypeScript and Node strips the
    // types at load time. That means every relative import has to name the
    // file that is actually on disk, extension and all.
    "allowImportingTsExtensions": true,

    // Type stripping only erases; it cannot *transform*. Enums, namespaces
    // and constructor parameter properties all need real codegen, so this
    // flag rejects them at type-check time rather than at a user's runtime.
    "erasableSyntaxOnly": true
  },
  "include": ["app/src", "cli", "tools", "test"]
}
